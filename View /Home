<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Home</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f5f2ee;
            color: #2b1a10;
        }

        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 40px;
            background-color: white;
            border-bottom: 2px solid #4a2c17;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: bold;
            font-size: 18px;
        }

        .logo img {
            width: 45px;
            height: 45px;
            border-radius: 50%;
        }

        .buscador {
            padding: 8px 15px;
            border-radius: 20px;
            border: 1px solid #ccc;
            width: 350px;
        }

        nav {
            display: flex;
            gap: 25px;
        }

        nav a {
            text-decoration: none;
            color: #2b1a10;
            font-size: 14px;
        }

        .hero {
            position: relative;
            margin: 20px 40px;
            border-radius: 15px;
            overflow: hidden;
        }

        .hero img {
            width: 100%;
            height: 320px;
            object-fit: cover;
            display: block;
        }

        .hero-texto {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 50%;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .hero-texto h1 {
            font-size: 36px;
            margin: 0 0 10px 0;
        }

        .hero-texto p {
            font-size: 14px;
            margin-bottom: 20px;
        }

        .botones {
            display: flex;
            gap: 15px;
        }

        .btn-cafe {
            background-color: #4a2c17;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
        }

        .btn-blanco {
            background-color: rgba(255, 255, 255, 0.6);
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
        }

        section {
            padding: 0 40px;
            margin-bottom: 35px;
        }

        section h2 {
            margin-bottom: 15px;
        }

        .categorias {
            display: flex;
            gap: 20px;
        }

        .categoria {
            border: 1px solid #ccc;
            border-radius: 25px;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            background-color: white;
        }

        .productos {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .tarjeta {
            background-color: white;
            border: 1px solid #ddd;
            border-radius: 10px;
            overflow: hidden;
        }

        .tarjeta img {
            width: 100%;
            height: 150px;
            object-fit: cover;
        }

        .tarjeta-info {
            padding: 12px;
        }

        .tarjeta-info h3 {
            margin: 0 0 5px 0;
            font-size: 16px;
        }

        .tarjeta-info p {
            margin: 0 0 8px 0;
            font-size: 13px;
            color: #555;
        }

        .precio {
            font-weight: bold;
            margin-bottom: 10px;
        }

        .tarjeta-info button {
            width: 100%;
            background-color: #4a2c17;
            color: white;
            border: none;
            padding: 10px;
            border-radius: 6px;
            cursor: pointer;
        }

        .promo {
            background-color: #2b1a10;
            color: white;
            border-radius: 15px;
            padding: 30px 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .promo-texto h2 {
            font-size: 28px;
            margin: 0 0 10px 0;
        }

        .promo-texto .precio-promo {
            font-size: 24px;
            font-weight: bold;
        }

        .promo-texto .antes {
            text-decoration: line-through;
            color: #ccc;
            font-size: 14px;
        }

        .promo img {
            width: 300px;
            border-radius: 10px;
        }

        footer {
            background-color: #e9e4de;
            padding: 30px 40px;
            display: flex;
            justify-content: space-between;
        }

        footer h2 {
            margin-top: 0;
        }

        .footer-iconos {
            display: flex;
            gap: 40px;
        }

        .footer-iconos div {
            text-align: center;
            font-size: 13px;
            max-width: 150px;
        }
    </style>
</head>

<body>

