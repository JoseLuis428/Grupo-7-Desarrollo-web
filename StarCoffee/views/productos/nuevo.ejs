<%- include('../partials/head') %>
<%- include('../partials/header') %>

<a href="/productos" class="volver">&#10094; Volver</a>

<div class="formulario">
  <h2>Nuevo producto</h2>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form action="/productos" method="POST">
    <label for="nombre">Nombre</label>
    <input type="text" id="nombre" name="nombre" value="<%= producto.nombre %>">

    <label for="descripcion">Descripción</label>
    <textarea id="descripcion" name="descripcion" rows="4"><%= producto.descripcion %></textarea>

    <label for="precio">Precio</label>
    <input type="number" id="precio" name="precio" value="<%= producto.precio %>">

    <label for="imagen">URL de la imagen (opcional)</label>
    <input type="text" id="imagen" name="imagen" value="<%= producto.imagen %>">

    <button type="submit" class="boton">Crear producto</button>
  </form>
</div>

<%- include('../partials/footer') %>
